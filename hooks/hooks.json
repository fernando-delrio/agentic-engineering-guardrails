{
  "description": "Git es de Fernando: bloquea git add, commit y push lanzados por cualquier agente.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/bloquear-git.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
